<?xml version="1.0" encoding="utf-8"?>
<!--
  The scene-lit frame.
  Black letterbox bars top and bottom; the picture centred at 16:9 in a gate;
  controls in the side margins, which take their hue from the picture.
  Nothing is ever drawn over the picture except the gate marks.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bars">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- TOP BAR: the signal path -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:background="@color/bars">

            <com.jonathanandrei.phantombridge.ui.LinkChainView
                android:id="@+id/chain"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginEnd="88dp" />

            <TextView
                android:id="@+id/btnTheme"
                style="@style/Frame.Mark"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end|center_vertical"
                android:layout_marginEnd="16dp"
                android:background="@drawable/row_ripple"
                android:clickable="true"
                android:focusable="true"
                android:padding="10dp"
                android:text="SUN"
                android:textColor="@color/ink_on_bars" />
        </FrameLayout>

        <!-- MIDDLE: left margin | gate | right margin -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal">

            <!-- LEFT MARGIN: the three setup steps -->
            <LinearLayout
                android:id="@+id/marginLeft"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@color/frame"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingTop="12dp"
                android:paddingEnd="12dp">

                <TextView
                    style="@style/Frame.Label"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingBottom="4dp"
                    android:text="Bring the link up" />

                <LinearLayout
                    android:id="@+id/rowRegister"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:background="@drawable/row_ripple"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">
                    <TextView android:id="@+id/numRegister" style="@style/Frame.StepNumber" android:layout_width="30dp" android:layout_height="30dp" android:layout_marginEnd="10dp" android:text="1" />
                    <TextView style="@style/Frame.Step" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:maxLines="1" android:text="Register SDK" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/rowConnect"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:background="@drawable/row_ripple"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">
                    <TextView android:id="@+id/numConnect" style="@style/Frame.StepNumber" android:layout_width="30dp" android:layout_height="30dp" android:layout_marginEnd="10dp" android:text="2" />
                    <TextView android:id="@+id/lblConnect" style="@style/Frame.Step" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:maxLines="1" android:text="Connect drone" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/rowBridge"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:background="@drawable/row_ripple"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">
                    <TextView android:id="@+id/numBridge" style="@style/Frame.StepNumber" android:layout_width="30dp" android:layout_height="30dp" android:layout_marginEnd="10dp" android:text="3" />
                    <TextView android:id="@+id/lblBridge" style="@style/Frame.Step" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:maxLines="1" android:text="Start bridge" />
                </LinearLayout>

                <TextView
                    android:id="@+id/hint"
                    style="@style/Frame.Body"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingTop="10dp"
                    android:textColor="@color/ink_muted"
                    android:text="Laptop: adb forward tcp:8765 tcp:8765" />
            </LinearLayout>

            <!-- THE GATE: 16:9 picture, never covered -->
            <FrameLayout
                android:id="@+id/gateRim"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:background="@color/gate_rim"
                android:padding="1dp">
                <com.jonathanandrei.phantombridge.ui.GateView
                    android:id="@+id/gate"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:background="#000000">
                    <TextureView
                        android:id="@+id/videoView"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent" />
                </com.jonathanandrei.phantombridge.ui.GateView>
            </FrameLayout>

            <!-- RIGHT MARGIN: toggles and the log -->
            <LinearLayout
                android:id="@+id/marginRight"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@color/frame"
                android:orientation="vertical"
                android:paddingStart="12dp"
                android:paddingTop="12dp"
                android:paddingEnd="16dp">

                <TextView
                    style="@style/Frame.Label"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingBottom="4dp"
                    android:text="Phone" />

                <LinearLayout
                    android:id="@+id/rowBind"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:background="@drawable/row_ripple"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">
                    <TextView style="@style/Frame.Step" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="Bind to Wi-Fi" />
                    <TextView android:id="@+id/markBind" style="@style/Frame.Mark" android:layout_width="wrap_content" android:layout_height="wrap_content" android:background="@drawable/mark_on" android:text="on" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/rowSwap"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:background="@drawable/row_ripple"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">
                    <TextView style="@style/Frame.Step" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="Swap N/E axes" />
                    <TextView android:id="@+id/markSwap" style="@style/Frame.Mark" android:layout_width="wrap_content" android:layout_height="wrap_content" android:background="@drawable/mark_off" android:text="off" />
                </LinearLayout>

                <TextView
                    style="@style/Frame.Label"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingTop="10dp"
                    android:paddingBottom="2dp"
                    android:text="Log" />

                <ScrollView
                    android:id="@+id/logScroll"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:fadeScrollbars="true"
                    android:scrollbars="none">
                    <TextView
                        android:id="@+id/logText"
                        style="@style/Frame.Body"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textSize="12sp"
                        android:textColor="@color/ink_muted"
                        android:text="" />
                </ScrollView>
            </LinearLayout>
        </LinearLayout>

        <!-- BOTTOM BAR: telemetry readouts (e-stop overlays the right end) -->
        <LinearLayout
            android:id="@+id/bottomBar"
            android:layout_width="match_parent"
            android:layout_height="68dp"
            android:background="@color/bars"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="20dp"
            android:paddingEnd="120dp">

            <include layout="@layout/readout" android:id="@+id/roAlt" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1.2" />
            <include layout="@layout/readout" android:id="@+id/roHdg" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" />
            <include layout="@layout/readout" android:id="@+id/roSats" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" />
            <include layout="@layout/readout" android:id="@+id/roBat" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" />
            <include layout="@layout/readout" android:id="@+id/roMode" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1.4" />
            <include layout="@layout/readout" android:id="@+id/roSw" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="0.8" />
            <include layout="@layout/readout" android:id="@+id/roFps" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="0.9" />
        </LinearLayout>
    </LinearLayout>

    <!-- THE E-STOP: bottom right, under the right thumb, the only raised object -->
    <com.jonathanandrei.phantombridge.ui.EStopView
        android:id="@+id/estop"
        android:layout_width="96dp"
        android:layout_height="96dp"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="14dp"
        android:layout_marginBottom="6dp" />
</FrameLayout>
